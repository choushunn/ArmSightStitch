{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "vcpkg + Qt6 (MinGW + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/vcpkg-mingw",
      "environment": {
        "PATH": "C:/Programs/Qt/Tools/mingw1310_64/bin;C:/Programs/Qt/Tools/Ninja;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_MODE": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "VCPKG_HOST_TRIPLET": "x64-mingw-static",
        "VCPKG_BUILD_TYPE": "release",
        "Qt6_DIR": "C:/Programs/Qt/6.10.1/mingw_64/lib/cmake/Qt6",
        "CMAKE_PREFIX_PATH": "C:/Programs/Qt/6.10.1/mingw_64",
        "CMAKE_MAKE_PROGRAM": "C:/Programs/Qt/Tools/Ninja/ninja.exe",
        "CMAKE_C_COMPILER": "C:/Programs/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/Programs/Qt/Tools/mingw1310_64/bin/g++.exe"
      }
    },
    {
      "name": "msvc",
      "displayName": "vcpkg + system Qt6 (MSVC) + CUDA",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/vcpkg-msvc",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": "OFF",
        "Qt6_DIR": "C:/Programs/Qt/6.10.1/msvc2022_64/lib/cmake/Qt6",
        "CMAKE_PREFIX_PATH": "C:/Programs/Qt/6.10.1/msvc2022_64",
        "CUDAToolkit_ROOT": "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.2"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "deploy",
      "configurePreset": "default",
      "displayName": "Build + Deploy Qt deps (MinGW)",
      "targets": ["deploy"]
    },
    {
      "name": "msvc",
      "configurePreset": "msvc"
    },
    {
      "name": "msvc-deploy",
      "configurePreset": "msvc",
      "displayName": "Build + Deploy Qt deps (MSVC)",
      "targets": ["deploy"]
    }
  ]
