{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "vcpkg + Qt6 (MinGW + Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/vcpkg-mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_MODE": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "VCPKG_HOST_TRIPLET": "x64-mingw-static",
        "CMAKE_PREFIX_PATH": "C:/Programs/Qt/6.10.1/mingw_64",
        "CMAKE_MAKE_PROGRAM": "C:/Programs/Qt/Tools/Ninja/ninja.exe"
      }
    },
    {
      "name": "msvc",
      "displayName": "vcpkg + system Qt6 (MSVC)",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/vcpkg-msvc",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_MODE": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_PREFIX_PATH": "C:/Programs/Qt/6.10.1/msvc2022_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "msvc",
      "configurePreset": "msvc"
    }
  ]
}
