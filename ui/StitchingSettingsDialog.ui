<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>StitchingSettingsDialog</class>
 <widget class="QDialog" name="StitchingSettingsDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>400</width>
    <height>380</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>图像拼接设置</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing">
    <number>4</number>
   </property>
   <property name="leftMargin">
    <number>4</number>
   </property>
   <property name="topMargin">
    <number>4</number>
   </property>
   <property name="rightMargin">
    <number>4</number>
   </property>
   <property name="bottomMargin">
    <number>4</number>
   </property>
   <item>
    <widget class="QGroupBox" name="settingsGroup">
     <property name="title">
      <string>拼接参数</string>
     </property>
     <layout class="QFormLayout" name="settingsLayout">
      <property name="verticalSpacing">
       <number>4</number>
      </property>
      <property name="horizontalSpacing">
       <number>4</number>
      </property>
      <property name="leftMargin">
       <number>4</number>
      </property>
      <property name="topMargin">
       <number>4</number>
      </property>
      <property name="rightMargin">
       <number>4</number>
      </property>
      <property name="bottomMargin">
       <number>4</number>
      </property>
      <item row="0" column="0">
       <widget class="QLabel" name="labelGridX">
        <property name="text">
         <string>网格列数 (X):</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QSpinBox" name="gridXSpin">
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="maximum">
         <number>50</number>
        </property>
        <property name="value">
         <number>10</number>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="labelGridY">
        <property name="text">
         <string>网格行数 (Y):</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="gridYSpin">
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="maximum">
         <number>50</number>
        </property>
        <property name="value">
         <number>10</number>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="labelCenterCrop">
        <property name="text">
         <string>中心裁剪 (px):</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QSpinBox" name="centerCropSpin">
        <property name="minimum">
         <number>0</number>
        </property>
        <property name="maximum">
         <number>5000</number>
        </property>
        <property name="value">
         <number>1775</number>
        </property>
        <property name="suffix">
         <string> px</string>
        </property>
        <property name="toolTip">
         <string>中心裁剪尺寸 (0=不裁剪)，类似 stitch.py 的 crop_size=1775</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="labelInputDir">
        <property name="text">
         <string>输入目录:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QLineEdit" name="inputDirEdit">
        <property name="placeholderText">
         <string>图像保存路径</string>
        </property>
        <property name="text">
         <string notr="true">./captured_images</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="labelFeatherWidth">
        <property name="text">
         <string>羽化宽度:</string>
        </property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QSpinBox" name="featherWidthSpin">
        <property name="minimum">
         <number>0</number>
        </property>
        <property name="maximum">
         <number>500</number>
        </property>
        <property name="value">
         <number>120</number>
        </property>
        <property name="suffix">
         <string> px</string>
        </property>
        <property name="toolTip">
         <string>羽化宽度 (0=禁用)，邻接边余弦渐变融合消除接缝，越大过渡越柔和</string>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="labelAlgorithm">
        <property name="text">
         <string>拼接算法:</string>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QComboBox" name="algorithmCombo">
        <property name="toolTip">
         <string>0=网格 1=特征匹配 2=Z轴缩放 3=接缝羽化 4=高级网格(Z校正+裁剪偏移+羽化)</string>
        </property>
        <item>
         <property name="text">
          <string>0 - 网格拼接 (Grid)</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>1 - 特征匹配 (Feature)</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>2 - Z轴缩放网格 (Z-Scale)</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>3 - 接缝羽化 (Seam Feather)</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>4 - 高级网格拼接 (Advanced Grid)</string>
         </property>
        </item>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="standardButtons">
      <set>QDialogButtonBox::Ok|QDialogButtonBox::Cancel</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections>
  <connection>
   <sender>buttonBox</sender>
   <signal>accepted()</signal>
   <receiver>StitchingSettingsDialog</receiver>
   <slot>accept()</slot>
  </connection>
  <connection>
   <sender>buttonBox</sender>
   <signal>rejected()</signal>
   <receiver>StitchingSettingsDialog</receiver>
